# Privy app ID (public). Leave empty to run the clearly-labeled simulated sign-in for UI review.
NEXT_PUBLIC_PRIVY_APP_ID=

# Live Market data (server-only — never prefix these with NEXT_PUBLIC_).
# Without them the Live Market shows SIM-labeled fallback prices (crypto still streams from Coinbase's public feed).
COINGECKO_API_KEY=
FINNHUB_API_KEY=
